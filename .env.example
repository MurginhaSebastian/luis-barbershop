# Copiar a .env. Credenciales del Postgres local de docker-compose.yml (solo desarrollo).
DATABASE_URL=postgres://barbershop:barbershop@localhost:5433/barbershop


# Panel del barbero: genera estos valores con `npm run panel:clave`. Sin ellos el panel no deja entrar.
PANEL_PASSWORD_HASH=
PANEL_SESSION_SECRET=

# Fotos subidas desde el panel. Con Supabase: bucket público y la clave service_role (solo servidor).
# Sin Supabase, en desarrollo se guardan en .uploads/. En producción sin Supabase la subida se desactiva,
# salvo IMAGE_STORAGE=local en un servidor con disco propio.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=
IMAGE_STORAGE=

# Avisos push al panel por cada reserva nueva: genera las claves con `npm run panel:push`.
VAPID_SUBJECT=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# WhatsApp Cloud API (Meta for Developers > tu app > WhatsApp). Sin estas cuatro, las citas se confirman a
# mano desde el panel, como antes. WHATSAPP_VERIFY_TOKEN lo inventas tú y lo repites al configurar el webhook.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# Dirección pública de la web (con https://), para los enlaces de los mensajes de WhatsApp.
SITE_URL=
