# Copiar a .env. Credenciales del Postgres local de docker-compose.yml (solo desarrollo).
DATABASE_URL=postgres://barbershop:barbershop@localhost:5433/barbershop

# Contacto del negocio (opcional; lo que falte no se muestra). WhatsApp con código de país: 51 + 9 dígitos.
# Parte de la página se genera al compilar: tras cambiar estos valores hay que volver a hacer `npm run build`.
SHOP_WHATSAPP=
SHOP_ADDRESS=
SHOP_MAPS_URL=
SHOP_INSTAGRAM_URL=
SHOP_FACEBOOK_URL=
SHOP_TIKTOK_URL=
# Libro de Reclamaciones virtual (obligatorio en Perú para negocios con atención al público).
SHOP_COMPLAINTS_URL=

# Panel del barbero: genera estos valores con `npm run panel:clave`. Sin ellos el panel no deja entrar.
PANEL_PASSWORD_HASH=
PANEL_SESSION_SECRET=
