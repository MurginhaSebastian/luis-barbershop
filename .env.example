# Copiar a .env. Credenciales del Postgres local de docker-compose.yml (solo desarrollo).
DATABASE_URL=postgres://barbershop:barbershop@localhost:5433/barbershop


# Panel del barbero: genera estos valores con `npm run panel:clave`. Sin ellos el panel no deja entrar.
PANEL_PASSWORD_HASH=
PANEL_SESSION_SECRET=

# Fotos subidas desde el panel. Con Supabase: bucket público y la clave service_role (solo servidor).
# Sin Supabase, en desarrollo se guardan en .uploads/. En producción sin Supabase la subida se desactiva,
# salvo IMAGE_STORAGE=local en un servidor con disco propio.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=
IMAGE_STORAGE=
# Carpeta de las fotos con IMAGE_STORAGE=local (en Railway, la ruta del volumen).
UPLOADS_DIR=

# Avisos push al panel por cada reserva nueva: genera las claves con `npm run panel:push`.
VAPID_SUBJECT=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# WhatsApp Cloud API (Meta for Developers > tu app > WhatsApp). Sin estas cuatro, las citas se confirman a
# mano desde el panel, como antes. WHATSAPP_VERIFY_TOKEN lo inventas tú y lo repites al configurar el webhook.
# El token también se acepta como WHATSAPP_ACCESS_TOKEN (el nombre que usa Meta).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# El número conectado a la API (solo cifras, con 51): un chip aparte, NO el WhatsApp de Luis, que sigue en
# /panel/web para el botón flotante. A este número escriben los clientes para confirmar.
WHATSAPP_DISPLAY_NUMBER=

# Dirección pública de la web (con https://), para los enlaces de los mensajes de WhatsApp.
SITE_URL=

# Secreto del ciclo de confirmaciones: aviso a -35 min, en riesgo a -15, vencida a su hora (GET /api/cron/vencer cada 5 minutos con
# "Authorization: Bearer <CRON_SECRET>"). Genera uno largo y aleatorio.
CRON_SECRET=

# Asistente de IA en WhatsApp. Vacío: responde el asistente básico (código y palabras clave).
# Con AI_PROVIDER=groq y GROQ_API_KEY (console.groq.com) responde la IA; necesita WhatsApp configurado.
# AI_MODEL es opcional: por defecto openai/gpt-oss-120b (llama-3.3-70b-versatile ya no está en Groq).
AI_PROVIDER=
GROQ_API_KEY=
AI_MODEL=
# Modelo de respaldo ante 429 o 5xx del principal (opcional; por defecto openai/gpt-oss-20b).
AI_FALLBACK_MODEL=
# Milisegundos que el asistente de IA espera, tras un texto, por más mensajes seguidos del mismo celular para
# atenderlos de una vez. Por defecto 3500; 0 lo apaga.
WHATSAPP_DEBOUNCE_MS=

# Solo para npm run lighthouse: ruta de Chrome o Edge si no está en su sitio.
CHROME_PATH=
